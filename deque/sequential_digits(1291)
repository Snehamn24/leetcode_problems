Example 1:

Input: low = 100, high = 300
Output: [123,234]
Example 2:

Input: low = 1000, high = 13000
Output: [1234,2345,3456,4567,5678,6789,12345]

#solution
from collections import deque

class Solution:
    def sequentialDigits(self, low: int, high: int):
        q = deque(range(1, 10))
        ans = []

        while q:
            num = q.popleft()

            if low <= num <= high:
                ans.append(num)

            last = num % 10

            if last < 9:
                new_num = num * 10 + (last + 1)

                if new_num <= high:
                    q.append(new_num)

        return ans

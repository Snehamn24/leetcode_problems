* As the input array is sorted in increasing order we can reduce the time complexity to o(n) using the two pointer approach

# two-pointer approach
class Solution:
    def twoSum(self, numbers: List[int], target: int) -> List[int]:
        left = 0
        right = len(numbers)-1
        while(left<right):
            total=numbers[left]+numbers[right]
            if total==target:
                return [left+1,right+1]
            elif total<target:
                left+=1
            else:
                right-=1
# We start from the end because it contains the largest numbers.
# This helps quickly decide whether to increase or decrease the sum.

#time complexity = o(n)
#space complexity = o(1) because no extra memory space is taken by new array hashmap or any other data structure only the i , j , total are used

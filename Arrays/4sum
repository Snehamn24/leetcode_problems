Example 1:

Input: nums = [1,0,-1,0,-2,2], target = 0
Output: [[-2,-1,1,2],[-2,0,0,2],[-1,0,0,1]]
Example 2:

Input: nums = [2,2,2,2,2], target = 8
Output: [[2,2,2,2]]

# Solution
class Solution:
    def fourSum(self, nums: List[int], target: int) -> List[List[int]]:
        #here we will have one more vaiable called j and start i after j and left after i
        nums.sort()
        res = []
        for j in range(0,len(nums)-3):
            if j>0 and nums[j]==nums[j-1]:
                continue
          
            # I am already setting 2 varibales so that gap from end is 2 only
            for i in range(j+1,len(nums)-2):
                if i>j+1 and nums[i]==nums[i-1]:
                    continue
                left = i+1
                right = len(nums)-1
                while(left<right):
                    total_sum = nums[j]+nums[i]+nums[left]+nums[right]
                    if(total_sum<target):
                        left+=1
                    elif(total_sum>target):
                        right-=1
                    else:

                        res.append([nums[j],nums[i],nums[left],nums[right]])
                        while(left<right and nums[left]==nums[left+1]):
                            left+=1
                        while(left<right and nums[right]==nums[right-1]):
                            right-=1
                        left+=1
                        right-=1
        return res
                    
